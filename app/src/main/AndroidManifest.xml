<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- الوضع العائم (اختياري، يفعّله المستخدم بنفسه من إعدادات النظام) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- اللعب بالبلوتوث (الأجهزة المقترنة فقط، بلا بحث ولا موقع) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- لرؤية التطبيقات القابلة للتشغيل فقط (لاختيارها كغنائم تمثيلية بموافقتك). لا نستخدم QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".GhostThiefApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_art"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GhostThief">

        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.OnboardingActivity" android:exported="false" />
        <!-- configChanges: تدوير الشاشة لا يعيد إنشاء الشاشة فلا ينقطع اللعب الشبكي -->
        <activity
            android:name=".ui.GameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode" />
        <activity android:name=".ui.GarageActivity" android:exported="false" />
        <activity android:name=".ui.MultiplayerActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.TextPageActivity" android:exported="false" />

        <!-- ماسح QR من خدمات Google Play (بلا إذن كاميرا): تنزيل مسبق لوحدة الماسح -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />

        <service
            android:name=".floating.FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Optional user-enabled floating overlay showing a small cartoon game character" />
        </service>
    </application>
</manifest>
